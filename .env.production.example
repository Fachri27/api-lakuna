# Salin ke .env.production (berkas itu di-ignore Git) dan isi dengan nilai PRODUKSI.
# Dipakai oleh:  npm run regen:clips   (memperbaiki klip kartu video yang rusak di produksi)

# Database produksi (URL publik/TCP proxy Railway, bukan *.railway.internal)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DB"

# MinIO produksi (domain publik bucket di Railway)
MINIO_ENDPOINT=bucket-production-1adf.up.railway.app
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=ISI_ACCESS_KEY
MINIO_SECRET_KEY=ISI_SECRET_KEY
MINIO_BUCKET=lakuna-foto
