generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  email              String              @unique
  password           String
  realName           String?
  role               User_role           @default(USER)
  newsletter         Boolean             @default(true)
  avatarKey          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  cartItems          CartItem[]
  contributorBalance ContributorBalance?
  downloads          Download[]
  Earning            Earning[]
  favorites          Favorite[]
  licenses           License[]
  orders             Order[]
  Payout             Payout[]
  photos             Photo[]
  refreshTokens      RefreshToken[]
  subscription       Subscription?
  VoucherRedemption  VoucherRedemption[]

  @@index([email])
}

model Photo {
  id              String          @id @default(uuid())
  title           String
  /// Judul/deskripsi versi Inggris. `title`/`description` = versi Indonesia (bahasa utama).
  titleEn         String?
  description     String?         @db.VarChar(500)
  descriptionEn   String?         @db.VarChar(500)
  photographer    String?
  price           Int
  type            AssetType       @default(FOTO)
  width           Int?
  height          Int?
  format          String?
  originalKey     String
  thumbKey        String
  watermarkKey    String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  userId          String
  status          PhotoStatus     @default(APPROVED)
  location        String?
  /// Unggahan multi-berkas satu judul berbagi batchId (dikurasi per berkas).
  batchId         String?         @db.VarChar(64)
  /// Alasan penolakan dari admin — tampil ke kontributor.
  rejectNote      String?         @db.VarChar(500)
  cartItems       CartItem[]
  downloads       Download[]
  Earning         Earning[]
  EventPhoto      EventPhoto[]
  favorites       Favorite[]
  licenses        License[]
  orderItems      OrderItem[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoCategories PhotoCategory[]
  photoKeywords   PhotoKeyword[]

  @@index([title])
  @@index([createdAt])
  @@index([batchId])
  @@index([userId], map: "Photo_userId_fkey")
}

model Keyword {
  id            String         @id @default(uuid())
  name          String
  /// Bahasa kata kunci: "id" | "en". Nama yang sama boleh ada di kedua bahasa.
  lang          String         @default("id") @db.VarChar(2)
  photoKeywords PhotoKeyword[]

  @@unique([name, lang])
}

model Category {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  imageKey        String?
  photoCategories PhotoCategory[]
}

model PhotoCategory {
  id         String   @id @default(uuid())
  photoId    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  photo      Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, categoryId])
  @@index([categoryId], map: "PhotoCategory_categoryId_fkey")
}

model CartItem {
  id        String      @id @default(uuid())
  userId    String
  photoId   String
  license   LicenseType
  createdAt DateTime    @default(now())
  photo     Photo       @relation(fields: [photoId], references: [id])
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId, license])
  @@index([photoId], map: "CartItem_photoId_fkey")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  photoId   String
  createdAt DateTime @default(now())
  photo     Photo    @relation(fields: [photoId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
  @@index([photoId], map: "Favorite_photoId_fkey")
}

model Order {
  id                     String              @id @default(uuid())
  userId                 String
  total                  Int
  status                 OrderStatus         @default(PENDING)
  midtransOrderId        String?             @unique
  midtransToken          String?
  paidAt                 DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  standarLicenseRedeemed Boolean             @default(false)
  discountAmount         Int                 @default(0)
  voucherId              String?
  licenses               License[]
  user                   User                @relation(fields: [userId], references: [id])
  Voucher                Voucher?            @relation(fields: [voucherId], references: [id])
  items                  OrderItem[]
  VoucherRedemption      VoucherRedemption[]

  @@index([userId])
  @@index([status])
  @@index([voucherId], map: "Order_voucherId_fkey")
}

model OrderItem {
  id          String      @id @default(uuid())
  orderId     String
  photoId     String
  price       Int
  licenseType LicenseType
  order       Order       @relation(fields: [orderId], references: [id])
  photo       Photo       @relation(fields: [photoId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([photoId], map: "OrderItem_photoId_fkey")
}

model Download {
  id           String   @id @default(uuid())
  userId       String
  photoId      String
  downloadedAt DateTime @default(now())
  licenseId    String
  license      License  @relation(fields: [licenseId], references: [id])
  photo        Photo    @relation(fields: [photoId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([photoId])
  @@index([licenseId], map: "Download_licenseId_fkey")
}

model Subscription {
  id                 String               @id @default(uuid())
  userId             String               @unique
  quota              Int
  used               Int                  @default(0)
  billing            String
  payOption          String
  price              Int
  status             SubscriptionStatus   @default(ACTIVE)
  startedAt          DateTime             @default(now())
  expiresAt          DateTime
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  planId             String
  midtransOrderId    String?              @unique
  discountAmount     Int                  @default(0)
  voucherId          String?
  BillingInstallment BillingInstallment[]
  plan               Plan                 @relation(fields: [planId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  Voucher            Voucher?             @relation(fields: [voucherId], references: [id])
  VoucherRedemption  VoucherRedemption[]

  @@index([planId], map: "Subscription_planId_fkey")
  @@index([voucherId], map: "Subscription_voucherId_fkey")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "RefreshToken_userId_fkey")
}

model PhotoKeyword {
  id        String  @id @default(uuid())
  photoId   String
  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  photo     Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, keywordId])
  @@index([keywordId], map: "PhotoKeyword_keywordId_fkey")
}

model License {
  id         String      @id @default(uuid())
  userId     String
  photoId    String?
  type       LicenseType
  orderId    String?
  expiresAt  DateTime?
  createdAt  DateTime    @default(now())
  licenseKey String?
  downloads  Download[]
  order      Order?      @relation(fields: [orderId], references: [id])
  photo      Photo?      @relation(fields: [photoId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@unique([userId, type, photoId], name: "uq_license_user_type_photo")
  @@index([userId])
  @@index([orderId], map: "License_orderId_fkey")
  @@index([photoId], map: "License_photoId_fkey")
}

model Plan {
  id            String         @id @default(uuid())
  quota         Int
  priceMonthly  Int
  priceAnnual   Int
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  name          String
  badge         String?
  description   String?
  highlight     Boolean        @default(false)
  EventPlan     EventPlan[]
  subscriptions Subscription[]
}

model BillingInstallment {
  id              String       @id @default(uuid())
  subscriptionId  String
  monthNumber     Int
  amount          Int
  status          String       @default("PENDING")
  midtransOrderId String?
  snapToken       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  Subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}

model ContributorBalance {
  id             String   @id @default(uuid())
  contributorId  String   @unique
  pending        Int      @default(0)
  paidOut        Int      @default(0)
  lifetimeEarned Int      @default(0)
  updatedAt      DateTime @updatedAt
  User           User     @relation(fields: [contributorId], references: [id])
}

model Earning {
  id            String         @id @default(uuid())
  contributorId String
  photoId       String?
  source        Earning_source
  amount        Int
  orderId       String?
  period        String?
  createdAt     DateTime       @default(now())
  contributor   User           @relation(fields: [contributorId], references: [id])
  photo         Photo?         @relation(fields: [photoId], references: [id])

  @@unique([orderId, photoId, source])
  @@index([contributorId])
  @@index([period])
  @@index([photoId], map: "Earning_photoId_fkey")
}

model EventDiscount {
  id           String                   @id @default(uuid())
  name         String
  description  String?
  valueType    EventDiscount_valueType  @default(PERCENT)
  value        Int
  maxDiscount  Int?
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean                  @default(true)
  targetType   EventDiscount_targetType
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  eventPhotos  EventPhoto[]
  eventPlans   EventPlan[]

  @@index([isActive])
  @@index([targetType])
}

model EventPhoto {
  id            String        @id @default(uuid())
  eventId       String
  photoId       String
  event         EventDiscount @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photo         Photo         @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([eventId, photoId])
  @@index([photoId], map: "EventPhoto_photoId_fkey")
}

model EventPlan {
  id            String        @id @default(uuid())
  eventId       String
  planId        String
  event         EventDiscount @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plan          Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([eventId, planId])
  @@index([planId], map: "EventPlan_planId_fkey")
}

model Payout {
  id            String        @id @default(uuid())
  contributorId String
  amount        Int
  method        String
  reference     String?
  note          String?
  status        Payout_status @default(COMPLETED)
  processedBy   String?
  createdAt     DateTime      @default(now())
  processedAt   DateTime?
  contributor   User          @relation(fields: [contributorId], references: [id])

  @@index([contributorId])
}

model Photographer {
  id        String   @id @default(uuid())
  name      String   @unique
  bio       String?
  avatarKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pesan dari formulir Customer service (publik). Admin membacanya di CMS.
model SupportMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(191)
  /// pesanan | unduhan | langganan | lisensi | lainnya
  topic     String   @db.VarChar(24)
  orderId   String?  @db.VarChar(64)
  message   String   @db.VarChar(2000)
  /// NEW | READ | DONE
  status    String   @default("NEW") @db.VarChar(8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model SettlementRun {
  id               String   @id @default(uuid())
  period           String   @unique
  totalPool        Int
  totalDistributed Int
  ranAt            DateTime @default(now())
  ranBy            String?
}

model Voucher {
  id                String              @id @default(uuid())
  code              String              @unique
  description       String?
  scope             Voucher_scope       @default(BOTH)
  valueType         Voucher_valueType   @default(PERCENT)
  value             Int
  maxDiscount       Int?
  minSpend          Int?
  startsAt          DateTime
  endsAt            DateTime
  isActive          Boolean             @default(true)
  quotaTotal        Int?
  quotaPerUser      Int                 @default(1)
  usedCount         Int                 @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order             Order[]
  Subscription      Subscription[]
  redemptions       VoucherRedemption[]

  @@index([isActive])
  @@index([scope])
}

model VoucherRedemption {
  id             String        @id @default(uuid())
  voucherId      String
  userId         String
  orderId        String?
  subscriptionId String?
  amountCut      Int           @default(0)
  createdAt      DateTime      @default(now())
  Order          Order?        @relation(fields: [orderId], references: [id])
  Subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  Voucher        Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([subscriptionId])
  @@index([userId], map: "VoucherRedemption_userId_fkey")
  @@index([voucherId, userId])
}

enum AssetType {
  FOTO
  VIDEO
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum LicenseType {
  STANDAR
  SUBSCRIBE
}

enum Earning_source {
  STANDAR
  SUBSCRIPTION
}

enum EventDiscount_valueType {
  PERCENT
  NOMINAL
}

enum Voucher_scope {
  ORDER
  SUBSCRIPTION
  BOTH
}

enum Voucher_valueType {
  PERCENT
  NOMINAL
}

enum User_role {
  USER
  ADMIN
  CONTRIBUTOR
}

enum Payout_status {
  PENDING
  COMPLETED
  REJECTED
}

enum EventDiscount_targetType {
  PHOTO
  PLAN
}
