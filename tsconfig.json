{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2020",
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma.config.ts", "src/modules/auth/google.router.ts"]
}