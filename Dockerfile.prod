# API Lakuna Foto — image PRODUKSI (Railway). Image dev ada di ./Dockerfile.
#
# Tahap build: kompilasi TypeScript + generate Prisma client.
# Tahap run : hanya dist/ + dependensi produksi, plus ffmpeg & font:
#   - ffmpeg      thumbnail + pratinjau video ber-watermark (publicAssets.ts)
#   - font-dejavu teks pita kredit "lakunastock · ID"; tanpa font, alpine
#                 merender kotak kosong (tofu)
#   - openssl     wajib untuk Prisma engine
FROM node:22-alpine AS build
RUN apk add --no-cache openssl
WORKDIR /app
COPY package*.json ./
# Lockfile ditulis npm 11 (Mac); npm 10 bawaan node:22 membaca peer opsional
# vite (yaml) berbeda dan menolak `npm ci`. Samakan versinya.
RUN npm i -g npm@11 --no-audit --no-fund && npm ci --no-audit --no-fund
COPY prisma ./prisma
RUN npx prisma generate --schema prisma/schema.prisma
COPY tsconfig.json ./
COPY src ./src
RUN npx tsc
RUN npm prune --omit=dev
# prisma CLI ikut terprune (devDependency) padahal migrate deploy butuh saat
# start di Railway — pasang lagi tanpa disimpan ke package.json.
RUN npm install --no-save --no-audit --no-fund prisma@5.22.0

FROM node:22-alpine
RUN apk add --no-cache openssl ffmpeg fontconfig font-dejavu
WORKDIR /app
ENV NODE_ENV=production
# Berkas milik root & hanya-baca bagi proses; proses berjalan sebagai `node`.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
# Font Poppins untuk template lisensi mode overlay (licenseOverlay.ts).
COPY assets ./assets
COPY package.json ./
USER node
# Railway mengisi PORT sendiri; index.ts sudah membaca process.env.PORT.
# migrate deploy jalan tiap start (idempoten): skema MySQL Railway selalu
# sinkron tanpa langkah manual.
CMD ["sh", "-c", "npx prisma migrate deploy --schema prisma/schema.prisma && node dist/index.js"]
